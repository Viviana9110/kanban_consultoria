generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERUSER
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiagnosticStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum SWOTType {
  STRENGTH
  WEAKNESS
  OPPORTUNITY
  THREAT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ActionPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(USER)
  sessions       Session[]
  createdTickets Ticket[]  @relation("CreatedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  managedCompanies Company[] @relation("ConsultantCompanies")
  createdDiagnostics QualityDiagnostic[] @relation("CreatedDiagnostics")
  createdActionPlans  ActionPlan[]       @relation("CreatedActionPlans")
  responsibleItems    ActionItem[]       @relation("ResponsibleActionItems")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdById String
  assignedToId String?
  createdBy   User           @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo  User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
}

model Company {
  id             String   @id @default(cuid())
  name           String
  identification String   @unique
  industry       String
  description    String
  consultantId   String?
  consultant     User?    @relation("ConsultantCompanies", fields: [consultantId], references: [id], onDelete: SetNull)
  diagnostics    QualityDiagnostic[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([consultantId])
  @@index([name])
}

model QualityDiagnostic {
  id             String           @id @default(cuid())
  companyId      String
  title          String
  description    String
  status         DiagnosticStatus @default(DRAFT)
  createdById    String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("CreatedDiagnostics", fields: [createdById], references: [id], onDelete: Restrict)
  swotAnalysis   SWOTAnalysis?
  aiAnalysis     AIAnalysis?
  recommendations Recommendation[]
  actionPlans    ActionPlan[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@index([status])
}

model SWOTAnalysis {
  id           String           @id @default(cuid())
  diagnosticId String           @unique
  diagnostic   QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  items        SWOTItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model SWOTItem {
  id          String     @id @default(cuid())
  swotId      String
  type        SWOTType
  description String
  priority    Priority
  impact      Impact
  swot        SWOTAnalysis @relation(fields: [swotId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([swotId])
  @@index([type])
}

model AIAnalysis {
  id                    String           @id @default(cuid())
  diagnosticId          String           @unique
  executiveSummary      String
  diagnosis             String
  keyFindings           Json
  foStrategies          Json
  doStrategies          Json
  faStrategies          Json
  daStrategies          Json
  priorityRisks         Json
  priorityOpportunities Json
  recommendations       Json
  diagnostic            QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
}

model Recommendation {
  id             String              @id @default(cuid())
  diagnosticId   String
  title          String
  description    String
  priority       Priority
  expectedImpact String
  suggestedAction String
  status         RecommendationStatus @default(PENDING)
  diagnostic     QualityDiagnostic    @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  actionItems    ActionItem[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([diagnosticId])
  @@index([status])
}

model ActionPlan {
  id             String            @id @default(cuid())
  diagnosticId   String
  title          String
  description    String
  status         ActionPlanStatus  @default(DRAFT)
  createdById    String
  diagnostic     QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  createdBy      User              @relation("CreatedActionPlans", fields: [createdById], references: [id], onDelete: Restrict)
  items          ActionItem[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([diagnosticId])
  @@index([createdById])
  @@index([status])
}

model ActionItem {
  id               String            @id @default(cuid())
  actionPlanId     String
  recommendationId String?
  title            String
  description      String
  priority         Priority
  status           ActionItemStatus  @default(PENDING)
  responsibleId    String?
  dueDate          DateTime?
  actionPlan       ActionPlan        @relation(fields: [actionPlanId], references: [id], onDelete: Cascade)
  recommendation   Recommendation?   @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  responsible      User?             @relation("ResponsibleActionItems", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([actionPlanId])
  @@index([recommendationId])
  @@index([responsibleId])
  @@index([status])
}
