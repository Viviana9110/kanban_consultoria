generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERUSER
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DiagnosticStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum SWOTType {
  STRENGTH
  WEAKNESS
  OPPORTUNITY
  THREAT
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum Impact {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(USER)
  sessions       Session[]
  createdTickets Ticket[]  @relation("CreatedTickets")
  assignedTickets Ticket[] @relation("AssignedTickets")
  managedCompanies Company[] @relation("ConsultantCompanies")
  createdDiagnostics QualityDiagnostic[] @relation("CreatedDiagnostics")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdById String
  assignedToId String?
  createdBy   User           @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo  User?          @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdById])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
}

model Company {
  id             String   @id @default(cuid())
  name           String
  identification String   @unique
  industry       String
  description    String
  consultantId   String?
  consultant     User?    @relation("ConsultantCompanies", fields: [consultantId], references: [id], onDelete: SetNull)
  diagnostics    QualityDiagnostic[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([consultantId])
  @@index([name])
}

model QualityDiagnostic {
  id             String           @id @default(cuid())
  companyId      String
  title          String
  description    String
  status         DiagnosticStatus @default(DRAFT)
  createdById    String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("CreatedDiagnostics", fields: [createdById], references: [id], onDelete: Restrict)
  swotAnalysis   SWOTAnalysis?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([companyId])
  @@index([createdById])
  @@index([status])
}

model SWOTAnalysis {
  id           String           @id @default(cuid())
  diagnosticId String           @unique
  diagnostic   QualityDiagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  items        SWOTItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model SWOTItem {
  id          String     @id @default(cuid())
  swotId      String
  type        SWOTType
  description String
  priority    Priority
  impact      Impact
  swot        SWOTAnalysis @relation(fields: [swotId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([swotId])
  @@index([type])
}
